# Neon PostgreSQL Database Connection URLs
# Production database connection string
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Dedicated test branch/database connection string (must be separate from DATABASE_URL)
TEST_DATABASE_URL=postgresql://user:password@ep-sample-test-pooler.region.aws.neon.tech/neondb?sslmode=require

# Application Secrets
JWT_SECRET=replace_with_a_long_random_secret_in_production
PORT=3000
